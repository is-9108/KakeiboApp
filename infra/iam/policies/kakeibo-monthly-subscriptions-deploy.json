{
  "Statement": [
    {
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:ap-northeast-1:255737342820:function:kakeibo-monthly-subscriptions",
      "Sid": "SubscriptionLambda"
    },
    {
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::255737342820:role/kakeibo-monthly-subscriptions-lambda",
        "arn:aws:iam::255737342820:role/kakeibo-monthly-subscriptions-scheduler"
      ],
      "Sid": "SubscriptionRoles"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-monthly-subscriptions-lambda",
      "Sid": "SubscriptionPassLambdaRole"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-monthly-subscriptions-scheduler",
      "Sid": "SubscriptionPassSchedulerRole"
    },
    {
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:scheduler:ap-northeast-1:255737342820:schedule/kakeibo-monthly/kakeibo-monthly-subscriptions",
      "Sid": "SubscriptionSchedulerSchedule"
    },
    {
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-monthly-subscriptions",
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-monthly-subscriptions:*"
      ],
      "Sid": "SubscriptionLogGroup"
    }
  ],
  "Version": "2012-10-17"
}
