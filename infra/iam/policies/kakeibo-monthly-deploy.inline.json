{
  "Statement": [
    {
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:DeleteTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:sns:ap-northeast-1:255737342820:kakeibo-monthly",
      "Sid": "MonthlySnsTopic"
    },
    {
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:sns:ap-northeast-1:255737342820:kakeibo-monthly",
        "arn:aws:sns:ap-northeast-1:255737342820:kakeibo-monthly:*"
      ],
      "Sid": "MonthlySnsSubscription"
    },
    {
      "Action": [
        "scheduler:CreateScheduleGroup",
        "scheduler:GetScheduleGroup",
        "scheduler:DeleteScheduleGroup",
        "scheduler:ListTagsForResource",
        "scheduler:TagResource",
        "scheduler:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:scheduler:ap-northeast-1:255737342820:schedule-group/kakeibo-monthly",
      "Sid": "MonthlySchedulerGroup"
    },
    {
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:scheduler:ap-northeast-1:255737342820:schedule/kakeibo-monthly/kakeibo-monthly",
      "Sid": "MonthlySchedulerSchedule"
    },
    {
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:iam::255737342820:role/kakeibo-monthly-lambda",
        "arn:aws:iam::255737342820:role/kakeibo-monthly-scheduler"
      ],
      "Sid": "MonthlyRoles"
    },
    {
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-monthly-lambda",
      "Sid": "MonthlyRoleLoggingPolicy"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-monthly-lambda",
      "Sid": "MonthlyPassRoles"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-monthly-scheduler",
      "Sid": "MonthlyPassSchedulerRole"
    },
    {
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:ap-northeast-1:255737342820:function:kakeibo-monthly",
      "Sid": "MonthlyLambda"
    },
    {
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-monthly",
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-monthly:*"
      ],
      "Sid": "MonthlyLogGroup"
    },
    {
      "Action": "logs:DescribeLogGroups",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "MonthlyDescribeLogGroups"
    }
  ],
  "Version": "2012-10-17"
}
