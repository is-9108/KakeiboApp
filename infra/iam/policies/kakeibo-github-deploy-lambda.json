{
  "Statement": [
    {
      "Action": [
        "lambda:Get*",
        "lambda:List*"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:ap-northeast-1:255737342820:function:kakeibo-*",
      "Sid": "ReadFunctions"
    },
    {
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:ap-northeast-1:255737342820:function:kakeibo-*",
      "Sid": "ManageFunctions"
    },
    {
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:List*",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-*",
        "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-*:*"
      ],
      "Sid": "ManageLogGroups"
    }
  ],
  "Version": "2012-10-17"
}
