{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::kakeibo-terraform-state-255737342820",
      "Sid": "StateBucket"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::kakeibo-terraform-state-255737342820/kakeibo/terraform.tfstate",
      "Sid": "StateObject"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::kakeibo-terraform-state-255737342820/kakeibo/terraform.tfstate.tflock",
      "Sid": "StateLock"
    },
    {
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucket*",
        "s3:GetAccelerateConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucketMultipartUploads",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::kakeibo-site-*",
        "arn:aws:s3:::kakeibo-artifacts-*"
      ],
      "Sid": "AppBuckets"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:DeleteObjectTagging",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::kakeibo-site-*/*",
        "arn:aws:s3:::kakeibo-artifacts-*/*"
      ],
      "Sid": "AppObjects"
    },
    {
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListVersionsByFunction",
        "lambda:ListTags",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:lambda:ap-northeast-1:255737342820:function:kakeibo-api",
      "Sid": "ApiLambda"
    },
    {
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-api-lambda",
      "Sid": "LambdaRole"
    },
    {
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-api-lambda",
      "Sid": "LambdaLoggingPolicy"
    },
    {
      "Action": "iam:PassRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:iam::255737342820:role/kakeibo-api-lambda",
      "Sid": "PassLambdaRole"
    },
    {
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:apigateway:ap-northeast-1::/apis/wcc5e12yqf",
        "arn:aws:apigateway:ap-northeast-1::/apis/wcc5e12yqf/*",
        "arn:aws:apigateway:ap-northeast-1::/tags/*"
      ],
      "Sid": "ApiGateway"
    },
    {
      "Action": "apigateway:POST",
      "Effect": "Allow",
      "Resource": "arn:aws:apigateway:ap-northeast-1::/apis",
      "Sid": "CreateApi"
    },
    {
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:GetFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:cloudfront::255737342820:distribution/E2UWQ35ESSQ4MT",
        "arn:aws:cloudfront::255737342820:function/kakeibo-spa-rewrite",
        "arn:aws:cloudfront::255737342820:origin-access-control/EFVP9LDI80ZZE"
      ],
      "Sid": "CloudFrontResources"
    },
    {
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:TagResource",
        "cloudfront:CreateFunction",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:ListDistributions",
        "cloudfront:ListFunctions",
        "cloudfront:ListOriginAccessControls"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CloudFrontCreateAndList"
    },
    {
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:ap-northeast-1:255737342820:secret:kakeibo/database-mjboif",
      "Sid": "DatabaseSecret"
    },
    {
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:logs:ap-northeast-1:255737342820:log-group:/aws/lambda/kakeibo-api:*",
      "Sid": "ReadLogs"
    },
    {
      "Action": "sts:GetCallerIdentity",
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "CallerIdentity"
    }
  ],
  "Version": "2012-10-17"
}
