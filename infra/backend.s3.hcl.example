# S3 backend の部分設定例。実値をコミットしない。
# `cp infra/backend.s3.hcl.example infra/backend.s3.hcl` して値を設定する。
# infra/backend.s3.hcl は .gitignore 済み。
#
# state 用バケットはアプリの root module とは別に bootstrap し、
# アプリの削除と一緒に削除しない（docs/deployment.md 5章）。
bucket = "kakeibo-terraform-state-123456789012"
key    = "kakeibo/terraform.tfstate"
region = "ap-northeast-1"

# use_lockfile / encrypt は infra/backend.tf で固定している。
