<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName Condition="'$(MonthlyBatchAssemblyName)' != ''">$(MonthlyBatchAssemblyName)</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kakeibo.Api.csproj" />
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="2.2.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.18" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.24" />
  </ItemGroup>
</Project>
