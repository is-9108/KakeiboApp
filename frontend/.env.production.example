# 本番ビルド用の Cognito 設定例。
# `cp frontend/.env.production.example frontend/.env.production.local` して実値を設定する。
# .env.production.local は .gitignore 済み。実値をコミットしないこと。
#
# これらはブラウザへ公開される識別情報であり、秘密鍵・パスワードではない。
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
