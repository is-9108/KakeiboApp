{
  "$schema": "https://opencode.ai/config.json",
  // 新規セッションの初期値。既存セッションの選択モデルは変更しません。
  "default_agent": "harness",
  // 窓口のモデルを変更するときは、このルート model と agents.harness.model の両方を変更する。片方だけの変更はしない。既存セッションの選択モデルは別途確認する。
  "model": "opencode/glm-5.3-flash-free",
  // 工程別モデルの設定場所はここだけです。agent の Markdown に重複させません。
  "agents": {
    // 窓口は上のルート model と agents.harness.model の両方を揃えて変更する。既存セッションの選択モデルは別途確認する。
    "harness": { "model": "opencode/glm-5.3-flash-free" },
    "harness-planner": { "model": "openai/gpt-6.1-sol" },
    "harness-implementer": { "model": "opencode/deepseek-v4.1-flash-free" },
    "harness-review-spec": { "model": "openai/gpt-6.1-sol" },
    "harness-review-quality": { "model": "openai/gpt-6-luna" },
    "harness-writer": { "model": "openai/gpt-6.1-sol" }
  },
  // 読み取り・検索・定型的な検証コマンドは確認なしに実行する。依存追加・削除・コミット・push・公開・DB移行などは "*" の ask による確認のまま残す。
  // 許可パターンは順序評価の後ろ一致。導入先の検証コマンドは同形式で追加する（例: cargo test *、go test *）。
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "python3 -m pytest *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" }
  ]
}
