# docker-compose.yml に渡す変数のひな形。
# このファイルを .env にコピーして使う（.env は .gitignore 済みのためコミットしない）。
#
#   cp .env.example .env
#
# POSTGRES_PASSWORD はローカル用 PostgreSQL のパスワード。空にすると docker compose が
# エラーを出す。好きな値を設定すること。
#
# COGNITO_* はCognito認証の設定。空のままだとテスト用のプレースホルダ値が入る
# （APIは起動するが実Cognitoでのログインはできない）。実Cognitoで確認するときは
# User Pool作成後に実値を設定すること（docs/authentication.md 参照）。

POSTGRES_USER=kakeibo
POSTGRES_PASSWORD=
POSTGRES_DB=kakeibo

COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
